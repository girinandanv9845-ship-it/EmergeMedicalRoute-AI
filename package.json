{
  "name": "emergemedicalroute-ai",
  "version": "1.0.0",
  "private": true,
  "description": "EmergeMedicalRoute AI — explainable medical appointment intake and safe administrative routing (hackathon prototype, synthetic data only)",
  "type": "module",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "dev": "concurrently -k -n api,web -c cyan,magenta \"npm:dev:server\" \"npm:dev:client\"",
    "dev:server": "tsx watch --clear-screen=false server/index.ts",
    "dev:client": "vite",
    "start": "npm run build && concurrently -k -n api,web -c cyan,magenta \"npm:start:server\" \"npm:preview\"",
    "start:server": "tsx server/index.ts",
    "preview": "vite preview",
    "build": "npm run typecheck && vite build",
    "typecheck": "tsc -p tsconfig.app.json && tsc -p tsconfig.server.json",
    "lint": "eslint .",
    "seed": "tsx server/db/seed-cli.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "report:tests": "tsx scripts/generate-test-report.ts",
    "ai:check": "tsx scripts/ollama-live-check.ts",
    "ai:chat-check": "tsx scripts/assistant-live-check.ts",
    "ollama:setup": "tsx scripts/ollama-setup.ts",
    "ai:build-models": "tsx scripts/build-models.ts",
    "ai:eval": "tsx scripts/ai-eval.ts",
    "ai:latency": "tsx scripts/ai-latency.ts"
  },
  "dependencies": {
    "@tanstack/react-query": "^5.104.5",
    "express": "^5.3.0",
    "helmet": "^8.3.0",
    "lucide-react": "^1.61.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router-dom": "^7.18.4",
    "recharts": "^2.15.4",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@playwright/test": "^1.64.1",
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/express": "^5.0.6",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/supertest": "^7.2.1",
    "@vitejs/plugin-react": "^4.7.0",
    "concurrently": "^9.2.5",
    "eslint": "^9.39.5",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^17.13.0",
    "jsdom": "^26.1.0",
    "supertest": "^7.3.1",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "typescript": "~5.8",
    "typescript-eslint": "^8.72.0",
    "vite": "^6.4.5",
    "vitest": "^3.2.7"
  }
}
