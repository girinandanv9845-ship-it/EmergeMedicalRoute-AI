# EmergeMedicalRoute AI — environment configuration. Placeholders only; no secrets are needed.

# Backend API port (the Vite dev server proxies /api to this port)
API_PORT=3001

# SQLite database file (created automatically). Use ":memory:" for ephemeral runs.
DB_PATH=./data/careroute.sqlite

# Optional AI-assisted interpretation. Code default is "disabled".
#   disabled – deterministic demonstration policy only
#   mock     – built-in deterministic MOCK provider (no model) for demonstrating the AI boundary
#   ollama   – a LOCAL model served by Ollama on this machine (no external AI service is used)
AI_PROVIDER=ollama

# Local Ollama server. Must be localhost/127.0.0.1 — remote hosts are refused by the backend.
OLLAMA_BASE_URL=http://localhost:11434
# Verified on Snapdragon X / 16 GB RAM / no GPU. Switch models with e.g. `ollama pull llama3.2:1b`.
OLLAMA_MODEL=llama3.2:3b

# Max time to wait for local inference on NON-emergency requests (emergencies never wait for AI).
AI_TIMEOUT_MS=30000

# The API starts and prepares Ollama by itself (no API key, everything stays on this machine):
#   OLLAMA_AUTO_START – launch the installed Ollama app / `ollama serve` if it is not running
#   OLLAMA_AUTO_PULL  – download OLLAMA_MODEL if it is not installed (~2 GB for llama3.2:3b, one time)
#   OLLAMA_WARMUP     – load the model into memory at start-up so the first chat reply is fast
OLLAMA_AUTO_START=true
OLLAMA_AUTO_PULL=true
OLLAMA_WARMUP=true

# Use task-specialised versions of OLLAMA_MODEL (built-in instructions + worked examples + tuned
# parameters; built automatically in seconds, share the same weights; see docs/ai-evaluation.md).
OLLAMA_SPECIALISED=true

# Emergency instruction text shown in the UI. Keep it location-neutral unless configured for a real locale.
EMERGENCY_INSTRUCTION=Contact your local emergency services immediately.

# Rate limit for write endpoints (requests per minute per client)
RATE_LIMIT_PER_MINUTE=120
